{
  "name": "@openfatture/sdi-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js && esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda.cjs",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "fast-xml-parser": "5.12.0"
  },
  "devDependencies": { "@types/aws-lambda": "^8.10.0", "esbuild": "^0.25.0" }
}
